#!/usr/bin/env bash
# ============================================================
#  maxAI — control script
#
#  Everything you need after the install, without remembering
#  Docker Compose flags:
#
#    ./maxai start | stop | restart | status | logs | update
#    ./maxai backup | restore <file> | doctor | uninstall
# ============================================================
set -euo pipefail

BLUE='\033[0;34m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; DIM='\033[2m'; NC='\033[0m'
info() { echo -e "${BLUE}➤${NC} $1"; }
ok()   { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC}  $1"; }
err()  { echo -e "${RED}✗${NC} $1" >&2; }

cd "$(dirname "$0")"

have() { command -v "$1" >/dev/null 2>&1; }

DOCKER="docker"

# Resolved lazily so `./maxai help` works on a machine without Docker.
ensure_docker() {
  if ! have docker; then
    err "Docker is not installed. Run: bash setup.sh"; exit 1
  fi
  if docker info >/dev/null 2>&1; then return; fi
  # Fall back to sudo when the current user can't reach the daemon.
  if [ "$(id -u)" -ne 0 ] && have sudo && sudo docker info >/dev/null 2>&1; then
    DOCKER="sudo docker"; return
  fi
  err "Cannot talk to the Docker daemon. Is it running?  (sudo systemctl start docker)"; exit 1
}

dc() { $DOCKER compose "$@"; }

env_value() { [ -f .env ] && grep -E "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2- || true; }

require_env() {
  if [ ! -f .env ]; then
    err "No .env found — maxAI has not been configured yet. Run: bash setup.sh"; exit 1
  fi
}

PORT="$(env_value PORT)"; PORT="${PORT:-80}"
URL="$(env_value FRONTEND_URL)"; URL="${URL:-http://localhost:${PORT}}"

wait_healthy() {
  info "Waiting for maxAI…"
  for _ in $(seq 1 60); do
    if curl -fsS --max-time 3 "http://localhost:${PORT}/health" >/dev/null 2>&1; then
      ok "maxAI is up — ${BLUE}${URL}${NC}"; return 0
    fi
    sleep 3
  done
  warn "maxAI is not answering yet. Recent logs:"
  dc logs --tail 40 backend || true
  return 1
}

usage() {
  cat <<'USAGE'
maxAI control script

  ./maxai start            Start maxAI (builds if needed) and wait until it answers
  ./maxai stop             Stop all containers
  ./maxai restart          Restart all containers
  ./maxai status           Show container status and the health endpoint
  ./maxai logs [service]   Follow logs (default: all; e.g. backend, web, postgres)
  ./maxai update           Pull the latest version, rebuild and restart
  ./maxai backup [file]    Dump the database to a .sql.gz file
  ./maxai restore <file>   Restore a dump created by `backup` (overwrites data!)
  ./maxai doctor           Check the environment and report obvious problems
  ./maxai uninstall        Stop everything and delete the containers + database volume
USAGE
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  start)
    ensure_docker
    require_env
    info "Starting maxAI…"
    dc up -d --build
    wait_healthy || exit 1
    ;;

  stop)
    ensure_docker
    dc down
    ok "maxAI stopped"
    ;;

  restart)
    ensure_docker
    require_env
    dc restart
    wait_healthy || exit 1
    ;;

  status)
    ensure_docker
    dc ps
    echo
    if curl -fsS --max-time 3 "http://localhost:${PORT}/health" 2>/dev/null; then
      echo; ok "Health endpoint OK — ${BLUE}${URL}${NC}"
    else
      warn "Health endpoint not reachable on port ${PORT}"
    fi
    ;;

  logs)
    ensure_docker
    if [ $# -gt 0 ]; then dc logs -f --tail 100 "$1"; else dc logs -f --tail 100; fi
    ;;

  update)
    ensure_docker
    require_env
    if [ -d .git ]; then
      info "Pulling the latest version…"
      git pull --ff-only
    else
      warn "Not a git checkout — skipping the pull."
    fi
    info "Rebuilding…"
    dc up -d --build
    wait_healthy || exit 1
    ok "maxAI updated"
    ;;

  backup)
    ensure_docker
    require_env
    target="${1:-maxai-backup-$(date +%Y%m%d-%H%M%S).sql.gz}"
    db="$(env_value POSTGRES_DB)"; db="${db:-maxai}"
    user="$(env_value POSTGRES_USER)"; user="${user:-maxai}"
    info "Dumping database '${db}' → ${target}"
    dc exec -T postgres pg_dump -U "$user" "$db" | gzip > "$target"
    ok "Backup written: ${target} ($(du -h "$target" | cut -f1))"
    ;;

  restore)
    ensure_docker
    require_env
    file="${1:-}"
    if [ -z "$file" ] || [ ! -f "$file" ]; then
      err "Usage: ./maxai restore <backup.sql.gz>"; exit 1
    fi
    db="$(env_value POSTGRES_DB)"; db="${db:-maxai}"
    user="$(env_value POSTGRES_USER)"; user="${user:-maxai}"
    warn "This overwrites the current contents of '${db}'."
    if [ -t 0 ]; then
      read -r -p "  Continue? [y/N]: " yn
      [[ "${yn:-N}" =~ ^[Yy] ]] || { echo "Aborted."; exit 1; }
    fi
    info "Restoring ${file}…"
    gunzip -c "$file" | dc exec -T postgres psql -q -U "$user" -d "$db"
    dc restart backend >/dev/null
    ok "Restore finished"
    ;;

  doctor)
    echo -e "${BLUE}maxAI doctor${NC}\n"
    docker_ok=0
    if ! have docker; then
      warn "Docker is not installed — run: bash setup.sh"
    else
      $DOCKER --version
      if docker info >/dev/null 2>&1 || { have sudo && sudo docker info >/dev/null 2>&1; }; then
        ensure_docker
        dc version
        docker_ok=1
      else
        warn "Docker is installed but the daemon is not reachable (sudo systemctl start docker)"
      fi
    fi

    [ -f .env ] && ok ".env present" || warn ".env missing — run: bash setup.sh"
    for key in JWT_SECRET POSTGRES_PASSWORD ADMIN_EMAIL; do
      [ -n "$(env_value "$key")" ] && ok "$key set" || warn "$key is empty"
    done
    if [ -n "$(env_value AI_API_KEY)" ]; then ok "AI_API_KEY set"; else warn "AI_API_KEY empty — set it in Settings → Admin"; fi

    if [ "$docker_ok" -eq 1 ]; then
      echo
      dc ps
    fi
    echo
    if curl -fsS --max-time 3 "http://localhost:${PORT}/health" >/dev/null 2>&1; then
      ok "Health endpoint OK on port ${PORT}"
    else
      warn "Health endpoint not reachable on port ${PORT}"
    fi
    ;;

  uninstall)
    ensure_docker
    warn "This removes the maxAI containers AND the database volume (all chats)."
    if [ -t 0 ]; then
      read -r -p "  Type 'delete' to confirm: " confirm
      [ "$confirm" = "delete" ] || { echo "Aborted."; exit 1; }
    fi
    dc down -v
    ok "maxAI removed. The source directory and .env are still here."
    ;;

  ''|-h|--help|help) usage ;;
  *) err "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
