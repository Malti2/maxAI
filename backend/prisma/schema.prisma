// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  name            String?
  avatarColor     String    @default("#0a84ff")
  onboardingDone  Boolean   @default(false)
  defaultModel    String    @default("auto")
  personality     String    @default("assistant")
  chatMode        Boolean   @default(false)
  soundEnabled    Boolean   @default(true)
  systemPrompt    String?

  // Web search (keyless: DuckDuckGo + Wikipedia + reader)
  webSearch          Boolean @default(false)
  webSearchSources   Int     @default(4)
  webSearchReadPages Boolean @default(true)

  // Generation settings (null = provider/tier default)
  temperature     Float?
  maxTokens       Int?
  historyLimit    Int       @default(50)
  reasoningEffort String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversations   Conversation[]
  refreshTokens   RefreshToken[]
}

model Conversation {
  id        String    @id @default(uuid())
  title     String    @default("New conversation")
  model     String    @default("auto")
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String    @id @default(uuid())
  role           String    // "user" | "assistant" | "system"
  content        String
  model          String?   // which model actually answered
  tokens         Int?      // token count
  reaction       String?   // tapback reaction (e.g. "love", "like") — Chat Mode only
  edited         Boolean   @default(false) // true once the user edits & resends
  sources        Json?     // web-search sources cited by this answer
  createdAt      DateTime  @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Self-relation for replies: a message can reply to one earlier message.
  replyToId      String?
  replyTo        Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReplies")

  @@index([conversationId, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Runtime-editable application settings (key/value). Used by the admin area to
// override the AI provider configuration without a redeploy. Secret values are
// stored encrypted (see lib/crypto.ts).
model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
