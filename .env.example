# ============================================
# Max AI - Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle sie aus
# ============================================

# Datenbank
POSTGRES_DB=maxai
POSTGRES_USER=maxai
POSTGRES_PASSWORD=HIER_EIN_SICHERES_PASSWORT_EINSETZEN

# Authentifizierung
# Generiere einen sicheren Schlüssel: openssl rand -hex 64
JWT_SECRET=HIER_EINEN_ZUFAELLIGEN_SCHLUESSEL_EINSETZEN

# Frontend URL (für CORS)
FRONTEND_URL=http://deine-domain.de

# Nginx Port (Standard: 80)
PORT=80

# ============================================
# Azure OpenAI API Konfiguration
# ============================================

# Globale Standardwerte (werden verwendet, wenn keine modellspezifischen Werte gesetzt sind)
AZURE_ENDPOINT=https://DEIN-RESOURCE.openai.azure.com
AZURE_API_KEY=DEIN_AZURE_API_KEY
AZURE_API_VERSION=2024-08-01-preview

# Max Lite (schnelles Modell, z.B. gpt-4o-mini)
AZURE_ENDPOINT_LITE=https://DEIN-RESOURCE.openai.azure.com
AZURE_API_KEY_LITE=DEIN_API_KEY_LITE
AZURE_DEPLOYMENT_LITE=gpt-4o-mini

# Max Pro (leistungsstarkes Modell, z.B. gpt-4o)
AZURE_ENDPOINT_PRO=https://DEIN-RESOURCE.openai.azure.com
AZURE_API_KEY_PRO=DEIN_API_KEY_PRO
AZURE_DEPLOYMENT_PRO=gpt-4o

# Max Beast (maximale Leistung, z.B. gpt-4o oder o1)
AZURE_ENDPOINT_BEAST=https://DEIN-RESOURCE.openai.azure.com
AZURE_API_KEY_BEAST=DEIN_API_KEY_BEAST
AZURE_DEPLOYMENT_BEAST=gpt-4o
