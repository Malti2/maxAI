# ============================================
# maxAI - Environment variables
# Copy this file to .env and fill it in
# ============================================

# Database
POSTGRES_DB=maxai
POSTGRES_USER=maxai
POSTGRES_PASSWORD=SET_A_SECURE_PASSWORD_HERE

# Authentication
# Generate a secure key: openssl rand -hex 64
JWT_SECRET=SET_A_RANDOM_KEY_HERE
# Optional token lifetimes (defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Encryption key for secrets stored in the DB (e.g. admin-set Azure keys).
# Optional: if omitted, a key is derived from JWT_SECRET. openssl rand -hex 32
ENCRYPTION_KEY=

# Admin account — only this email can access the admin area. If ADMIN_PASSWORD
# is also set, the account is created automatically on first boot.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Frontend URL (for CORS)
FRONTEND_URL=http://your-domain.com

# Node environment (development | production)
NODE_ENV=production

# Nginx port (default: 80)
PORT=80

# ============================================
# Azure OpenAI API configuration
# (You can also set / change all of this later in Settings → Admin)
# ============================================

# Global defaults (used when no model-specific values are set)
AZURE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_API_KEY=YOUR_AZURE_API_KEY
AZURE_API_VERSION=2024-08-01-preview

# Max Lite (fast model, e.g. gpt-4o-mini)
AZURE_ENDPOINT_LITE=https://YOUR-RESOURCE.openai.azure.com
AZURE_API_KEY_LITE=YOUR_API_KEY_LITE
AZURE_DEPLOYMENT_LITE=gpt-4o-mini

# Max Pro (powerful model, e.g. gpt-4o)
AZURE_ENDPOINT_PRO=https://YOUR-RESOURCE.openai.azure.com
AZURE_API_KEY_PRO=YOUR_API_KEY_PRO
AZURE_DEPLOYMENT_PRO=gpt-4o

# Max Beast (maximum performance, e.g. gpt-4o or o1)
AZURE_ENDPOINT_BEAST=https://YOUR-RESOURCE.openai.azure.com
AZURE_API_KEY_BEAST=YOUR_API_KEY_BEAST
AZURE_DEPLOYMENT_BEAST=gpt-4o
