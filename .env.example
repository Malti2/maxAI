# ============================================
# maxAI — environment variables
# Copy this file to .env and fill it in.
# (Or just run `bash setup.sh`, which writes this file for you.)
# ============================================

# ── Database ────────────────────────────────
POSTGRES_DB=maxai
POSTGRES_USER=maxai
POSTGRES_PASSWORD=SET_A_SECURE_PASSWORD_HERE

# ── Authentication ──────────────────────────
# Generate a secure key: openssl rand -hex 64
JWT_SECRET=SET_A_RANDOM_KEY_HERE
# Optional token lifetimes (defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Encryption key for secrets stored in the DB (e.g. admin-set API keys).
# Optional: if omitted, a key is derived from JWT_SECRET. openssl rand -hex 32
ENCRYPTION_KEY=

# ── Admin account ───────────────────────────
# Only this email can access the admin area. If ADMIN_PASSWORD is also set, the
# account is created automatically on first boot.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ── Server ──────────────────────────────────
# Public port maxAI is served on (http://your-server:PORT).
PORT=80
# Public URL / domain (used for CORS). Match how users reach the app.
FRONTEND_URL=http://localhost
# Node environment (development | production)
NODE_ENV=production

# ============================================
# AI provider
#
# maxAI talks to any endpoint that implements the standard Chat Completions API.
# That includes the major hosted providers as well as self-hosted gateways and
# local model servers. You can also set / change all of this later in the
# browser under Settings → Admin.
# ============================================

# Global defaults (used when no model-specific values are set)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=YOUR_API_KEY

# Model name requested for each tier
AI_MODEL_LITE=gpt-4o-mini
AI_MODEL_PRO=gpt-4o
AI_MODEL_BEAST=gpt-4o

# ── Optional per-tier overrides ─────────────
# Point a tier at a different endpoint or key (otherwise the globals apply).
# AI_BASE_URL_LITE=
# AI_API_KEY_LITE=
# AI_BASE_URL_PRO=
# AI_API_KEY_PRO=
# AI_BASE_URL_BEAST=
# AI_API_KEY_BEAST=

# ============================================
# Web search (no API key required)
#
# Max can ground answers in fresh web results using DuckDuckGo and Wikipedia,
# reading the pages through a plain-text reader. Everything runs server-side.
# ============================================

# Set to false to remove web search from the app entirely.
WEB_SEARCH_ENABLED=true
# Reader that turns a page into plain text. Swap it for a self-hosted instance
# if you don't want to depend on a third party.
WEB_SEARCH_READER_URL=https://r.jina.ai/
# Wikipedia languages tried (in order) when the search engines return nothing.
WEB_SEARCH_WIKI_LANGS=de,en
